# API reference, generated by Doxygen from the public headers.
#
# The headers are the reference: every entry point documents its contract and
# its threading rule there, so this only turns them into pages. Nothing under
# src/ is read, since what is not in a public header is not part of the API.
#
# Built on demand, never as part of ALL:
#
#   cmake --preset docs
#   cmake --build --preset docs
#
# and the pages land in <build dir>/api/html/index.html.

find_package(Doxygen REQUIRED)

set(DOXYGEN_PROJECT_NAME "Gyro")
set(DOXYGEN_PROJECT_NUMBER "${PROJECT_VERSION}")
set(DOXYGEN_PROJECT_BRIEF "${PROJECT_DESCRIPTION}")
set(DOXYGEN_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/api")

# A C API: no classes, no namespaces, and the pages should say so.
set(DOXYGEN_OPTIMIZE_OUTPUT_FOR_C YES)

# Every declaration in a public header is API, documented or not, and the
# inline helpers (gyro_request_invalid) are static by necessity.
set(DOXYGEN_EXTRACT_ALL YES)
set(DOXYGEN_EXTRACT_STATIC YES)

# Order matters in these headers: the file comment sets out the contract and
# the declarations follow it. Alphabetical order would scatter them.
set(DOXYGEN_SORT_MEMBER_DOCS NO)

# GYRO_API is the export attribute and means nothing to a reader: expanded to
# nothing, signatures read as they would to a caller. The platform macros are
# left to the headers themselves, which pick the POSIX layout when no
# compiler macro names Windows, as is the case under Doxygen.
set(DOXYGEN_ENABLE_PREPROCESSING YES)
set(DOXYGEN_MACRO_EXPANSION YES)
set(DOXYGEN_EXPAND_ONLY_PREDEF YES)
set(DOXYGEN_PREDEFINED "GYRO_API=")

# Shown as they are included: <gyro/tcp.h>, not a path on somebody's disk.
set(DOXYGEN_STRIP_FROM_PATH
        "${PROJECT_SOURCE_DIR}/gyro/include"
        "${PROJECT_BINARY_DIR}/gyro/include")
set(DOXYGEN_STRIP_FROM_INC_PATH ${DOXYGEN_STRIP_FROM_PATH})

set(DOXYGEN_FILE_PATTERNS "*.h")
set(DOXYGEN_QUIET YES)
set(DOXYGEN_WARN_IF_UNDOCUMENTED NO)

# version.h is generated at configure time, so it is read from the build tree;
# export.h, generated next to it, holds only the export macros.
doxygen_add_docs(gyro_docs
        "${PROJECT_SOURCE_DIR}/gyro/include/gyro"
        "${PROJECT_BINARY_DIR}/gyro/include/gyro/version.h"
        COMMENT "Generating the gyro API reference")
